# Database Configuration (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/mandi_price_cloud

# Government of India data.gov.in API Configuration
# Get your API Key from https://data.gov.in
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Authentication & Admin Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# Background Sync Scheduler
SYNC_INTERVAL_HOURS=6
ENABLE_SCHEDULER=true

# Server & CORS
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
